# --- required ---
PORT=4000
MONGO_URI=mongodb+srv://faizantanwar1611_db_user:pjtwKHDbc0QVuPmY@cluster0.pttkx1q.mongodb.net/?appName=Cluster0
JWT_SECRET=change-this-in-real-deployment
JWT_EXPIRES_IN=1h

# --- connection to the frontend ---
# Browser origins allowed to call this API (comma separated)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Public address of this API, used in uploaded photo links
PUBLIC_URL=http://localhost:4000

# --- processing ---
# inprocess: this server runs dedup, trust score and classification itself.
# external: your Kafka consumers do it (this server only stores and serves).
PIPELINE_MODE=inprocess

# --- optional ---
# Free key from openweathermap.org. Enables live conditions on the Overview page and official observations for the trust score.
OPENWEATHER_API_KEY=
UPLOAD_DIR=uploads
# Set to 1 to switch off rate limits while testing
RATE_LIMIT_DISABLED=0
# Accounts created by "npm run seed"
SEED_ADMIN_EMAIL=admin@nwa.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_MODERATOR_EMAIL=moderator@nwa.local
SEED_MODERATOR_PASSWORD=Moderator@12345
