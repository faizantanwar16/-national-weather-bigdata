# Frontend Dashboard Environment Variables

# Backend API URL (default: http://localhost:4000)
VITE_API_URL=http://localhost:4000

# Optional: If you want to use CARTO basemaps with your own free API key:
# VITE_CARTO_KEY=your_carto_api_key_here

# Optional: Custom Map Tile URL (defaults to Esri World Dark Gray Base with zero watermark)
# VITE_MAP_TILES=https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}
# Or standard OpenStreetMap:
# VITE_MAP_TILES=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
