# Copy this file to .env and fill in your own values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────
# Social media collectors
# ─────────────────────────────────────────────────────────────────────────────
BLUESKY_HANDLE=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

MASTODON_INSTANCE=https://mastodon.social
MASTODON_TOKEN=your_mastodon_access_token_here

# ─────────────────────────────────────────────────────────────────────────────
# Weather APIs
# ─────────────────────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweathermap_key_here
WEATHERAPI_KEY=your_weatherapi_com_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Database (must match backend-api MONGO_URI)
# ─────────────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/nwbdap

# ─────────────────────────────────────────────────────────────────────────────
# Backend API ingest (preferred path: Python POSTs here instead of writing
# Mongo directly; clustering, SSE, and audit logs all happen in one place)
# Set FORCE_DIRECT_MONGO=1 to bypass the API and write Mongo directly (faster
# but skips validation, rate limiting, and audit logging -- dev/debug only).
# ─────────────────────────────────────────────────────────────────────────────
API_URL=http://localhost:4000
INGEST_KEY=national-weather-shared-ingest-key-2026
# FORCE_DIRECT_MONGO=1
